# 依赖(靠 npm install 还原,不入库)
node_modules/

# 运行产物 / 日志
*.log
*.tmp

# 本地发布流水与产物(含账号/链接,不入库)
*.csv
editor-dump.md
*.png
*.jpg

# 凭据 / 环境变量
.env
.env.*
*.key

# 账号映射(含真实手机号+CSDN账号, 绝不入库)
accounts.json

# 一次性批量发布/预检脚本(硬编码真实账号与chip手机号=PII;仓库是公开的)。
# 批量发布走引擎的 publishBatch(),别把这类本地产物提交上来。
publish-*.js
prep-*.js
!publish-batch-example.js

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
